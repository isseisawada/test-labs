# freee アプリ設定
# https://developer.freee.co.jp/apps で作成したアプリの情報を入力してください
FREEE_CLIENT_ID=your_client_id_here
FREEE_CLIENT_SECRET=your_client_secret_here

# 以下は「python -m freee_expense setup」を実行すると自動で設定されます
FREEE_ACCESS_TOKEN=
FREEE_REFRESH_TOKEN=
FREEE_TOKEN_EXPIRES_AT=
FREEE_COMPANY_ID=

# Claude API キー（領収書 OCR に使用）
# https://console.anthropic.com で取得してください
ANTHROPIC_API_KEY=your_anthropic_api_key_here
