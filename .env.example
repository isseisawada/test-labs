# freee アプリ設定
# https://developer.freee.co.jp/apps で作成したアプリの情報を入力してください
FREEE_CLIENT_ID=your_client_id_here
FREEE_CLIENT_SECRET=your_client_secret_here

# 以下は「python -m freee_expense setup」を実行すると自動で設定されます
FREEE_ACCESS_TOKEN=
FREEE_REFRESH_TOKEN=
FREEE_TOKEN_EXPIRES_AT=
FREEE_COMPANY_ID=

# Claude API キー（領収書 OCR に使用）
# https://console.anthropic.com で取得してください
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------
# Web サービス別 ログイン情報
# ------------------------------------------------

# freee Web ログイン（Playwright 自動入力用）
FREEE_LOGIN_EMAIL=your_freee_email@example.com
FREEE_LOGIN_PASSWORD=your_freee_password

# GO タクシー (business.goinc.jp)
GO_EMAIL=your_go_email@example.com
GO_PASSWORD=your_go_password

# Stationwork (stationwork.jp)
STATIONWORK_EMAIL=your_stationwork_email@example.com
STATIONWORK_PASSWORD=your_stationwork_password

# note (note.com)
NOTE_EMAIL=your_note_email@example.com
NOTE_PASSWORD=your_note_password

# Apple サブスクリプション領収書（IMAP メール取得）
# Gmail の場合はアプリパスワードを使用: https://myaccount.google.com/apppasswords
# iCloud の場合: imap.mail.me.com
APPLE_RECEIPT_IMAP_HOST=imap.gmail.com
APPLE_RECEIPT_IMAP_PORT=993
APPLE_RECEIPT_EMAIL=your_apple_id_email@gmail.com
APPLE_RECEIPT_APP_PASSWORD=your_app_password_here
